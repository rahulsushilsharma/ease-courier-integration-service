PORT=3000
DB_PATH=./data/app.db

# retry / backoff for courier calls
COURIER_RETRY_COUNT=3
COURIER_RETRY_BASE_MS=300
COURIER_TIMEOUT_MS=8000

# bulk processing concurrency (parallel courier calls in-flight)
BULK_CONCURRENCY=10

# UrbaneBolt
URBANEBOLT_BASE_URL=https://uat-api.urbanebolt.example.com
URBANEBOLT_API_KEY=changeme
URBANEBOLT_API_SECRET=changeme
